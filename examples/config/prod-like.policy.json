{
  "require_approval_for_risks": ["HIGH", "IMPACT_CRITICAL", "CRITICAL"],
  "block_operations": ["DROP DATABASE", "DROP SCHEMA"],
  "require_recovery_for_critical": true,
  "block_unknown_or_parse_failure": true,
  "block_unrecoverable_operations": true,
  "max_snapshot_age_seconds": 120,
  "require_sidecar_heartbeat": true,
  "max_sidecar_heartbeat_seconds": 60,
  "require_object_checksum": false,
  "impact_analysis_enabled": true,
  "max_write_rows_without_critical": 250,
  "max_write_percent_without_critical": 10,
  "protected_tables": ["payments", "users"],
  "protected_columns": {
    "users": ["email", "plan"],
    "payments": ["amount", "status"]
  },
  "unknown_impact_action": "block",
  "recovery_groups": {},
  "max_blocked_attempts_per_window": 2,
  "quarantine_duration_seconds": 3600,
  "dangerous_retry_window_seconds": 900
}
