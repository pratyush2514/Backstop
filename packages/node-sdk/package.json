{
  "name": "@backstop/client",
  "version": "0.1.0-alpha.0",
  "description": "TypeScript/Node client for the backstop gateway.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/pratyush2514/Backstop",
  "repository": {
    "type": "git",
