# backstop local development environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:password@localhost/testdb

# S3 bucket for snapshots
S3_BUCKET=backstop-test

# MinIO endpoint (leave empty to use real AWS S3)
S3_ENDPOINT=http://localhost:9000

# S3 credentials (MinIO defaults shown)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

